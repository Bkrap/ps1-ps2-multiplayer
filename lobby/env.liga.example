# Liga sync — copy to lobby/.env.liga (do not commit secrets).
# See docs/LIGA_SYNC.md

LIGA_WP_URL=http://localhost:8888/liga-cms
LIGA_WP_USER=your-wp-login@example.com

# Prefer this on localhost HTTP (must match LIGA_SYNC_SECRET in wp-config.php):
LIGA_WP_SYNC_SECRET=

# Optional: WP Application Password (Users → Profile). Often awkward on HTTP localhost.
LIGA_WP_APP_PASSWORD=

LIGA_TEKKEN3_ID=0
LIGA_TEKKEN3_SLUG=tekken-3
# Ranked create/join require a liga-cms session when sync is configured:
LIGA_REQUIRE_AUTH=true
